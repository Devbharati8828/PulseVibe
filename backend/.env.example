# Environment Variables Template
# Copy to .env and fill in values

PORT=3001
NODE_ENV=development

# MySQL
DB_HOST=
DB_PORT=3307
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=10

# CORS — frontend origin
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
